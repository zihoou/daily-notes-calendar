{
  "name": "daily-notes-calendar",
  "version": "1.12.4",
  "description": "Open and create daily, weekly, and monthly notes from a theme-aware popup calendar.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs && tsc -noEmit -skipLibCheck",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "daily-notes",
    "calendar"
  ],
  "author": "zihoou",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "moment": "^2.31.0",
    "obsidian": "^1.7.2",
    "obsidian-daily-notes-interface": "^0.9.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
